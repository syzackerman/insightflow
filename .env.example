POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insightflow
POSTGRES_USER=insightflow_user
POSTGRES_PASSWORD=insightflow_pass

DATABASE_URL=jdbc:postgresql://localhost:5432/insightflow
DATABASE_USERNAME=insightflow_user
DATABASE_PASSWORD=insightflow_pass
INSIGHTFLOW_ANALYTICS_MODE=auto
DATABASE_CONNECTION_TIMEOUT_MS=2000
SPRING_SQL_INIT_MODE=never
SPRING_PROFILES_ACTIVE=

INSIGHTFLOW_AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

INSIGHTFLOW_JWT_SECRET=change-me-to-a-long-random-development-secret
INSIGHTFLOW_JWT_EXPIRATION_MINUTES=1440

